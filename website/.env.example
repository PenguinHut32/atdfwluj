# Server-side only. Never prefix these variables with NEXT_PUBLIC_.
# Leave empty to use explicitly labeled, scripted demo replies and curated images.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Opt-in paid image generation with gpt-image-1: one 1024x1024 PNG, low quality.
# Requires OPENAI_API_KEY and provider access to image generation.
# false uses the prepared /images gallery, not newly generated images.
# Custom portraits (sports/abs, suit, smile, profile) require this opt-in.
# Before exposing a paid key publicly, configure authentication and shared quotas.
ENABLE_IMAGE_GENERATION=false

# POST /api/chat accepts the complete conversation: at most 150 alternating
# user/assistant messages, ending with user; 6000 characters per message and
# 100000 total (JavaScript UTF-16 units). Oversized histories are rejected, never
# silently trimmed. An initial assistant greeting is allowed.
# JSON request bodies are streamed with a 700000-byte cap and 5-second deadline.
# Chat upstream deadline: 20 seconds. Image upstream deadline: 45 seconds.
# JSON errors use {"error":"Russian explanation"}; failures never become demo.
# Image data is capped at 8 MiB of base64; provider image JSON at 9 MiB.
# GET reports configured mode/capability, not provider health or account quota.
#
# Best-effort in-memory limits: 20 valid chat attempts/minute/client and 3 image
# generation attempts/10 minutes/client. Failed upstream attempts also count.
# At most 4096 client entries per process, expired after 10 idle minutes and
# evicted least-recently-used when full. Restarts/workers/eviction reset limits.
# Configure a TRUSTED proxy to overwrite X-Forwarded-For. Without this header,
# clients share one fallback bucket; untrusted forwarded headers can be spoofed.
# For production cost protection, enforce shared quotas/auth at your gateway.
# Origin and Sec-Fetch-Site are checked against the public Host header (falling
# back to the request URL). The proxy must preserve the browser-facing Host.
# Non-browser clients without these headers are allowed; CSRF checks are not auth.
# No provider errors, keys or conversation bodies are logged by this endpoint.
